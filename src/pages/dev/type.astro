---
import Base from '../../layouts/Base.astro';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/source-sans-3';
const pairs = [
  {
    id: 'A',
    name: 'Fraunces + Instrument Sans',
    d: "'Fraunces Variable'",
    b: "'Instrument Sans Variable'",
    dw: 600,
  },
  {
    id: 'B',
    name: 'Bricolage Grotesque + IBM Plex Sans',
    d: "'Bricolage Grotesque Variable'",
    b: "'IBM Plex Sans Variable'",
    dw: 800,
  },
  {
    id: 'C',
    name: 'Newsreader + Source Sans 3',
    d: "'Newsreader Variable'",
    b: "'Source Sans 3 Variable'",
    dw: 600,
  },
];
---

<Base
  title="Type specimen (temporary)"
  description="Temporary font pairing test. Delete before launch."
  noindex
>
  <div class="container-page py-10">
    <h1 style="font-size:var(--text-2xl)">Type specimen: three pairings</h1>
    <p class="text-[var(--color-slate)]">Temporary page. Delete before launch.</p>
    {pairs.map((p) => (
      <section class="pair" style={`--d:${p.d};--b:${p.b};--dw:${p.dw}`}>
        <p class="tag">
          {p.id}: {p.name}
        </p>
        <h2 class="display">AI, data and software careers, taught from zero.</h2>
        <h3 class="sub">What will my child learn in 624 hours?</h3>
        <p class="body">
          Three-year professional programs for students who have passed Class 10. Every month ends
          with an exam and a project you can show on GitHub. Learn · Develop · Create. Duration 624
          hours, 3 years, 36 months, ₹ and “quotes” and en–dash ranges 4–6 all render. Numbers
          0123456789.
        </p>
        <p class="body">
          <em>Italic sample: practice beats theory when the lab is open.</em>{' '}
          <strong>Bold sample: apply today.</strong>
        </p>
      </section>
    ))}
  </div>
</Base>

<style>
  .pair {
    border-top: 1px solid var(--color-line);
    padding: 2.5rem 0;
  }
  .tag {
    font-family: var(--b);
    font-size: 0.9rem;
    color: var(--color-slate);
    margin: 0 0 1rem;
  }
  .display {
    font-family: var(--d);
    font-weight: var(--dw);
    font-size: var(--text-display);
    line-height: 0.98;
    letter-spacing: -0.035em;
    max-width: 14ch;
  }
  .sub {
    font-family: var(--d);
    font-weight: var(--dw);
    font-size: var(--text-xl);
    margin: 1.5rem 0 0.5rem;
  }
  .body {
    font-family: var(--b);
    font-size: var(--text-base);
    max-width: 64ch;
    line-height: 1.6;
  }
</style>
