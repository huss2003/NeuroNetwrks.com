---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/ibm-plex-sans';
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** JSON-LD documents for this page (use graph() from src/lib/schema.ts) */
  jsonLd?: Record<string, unknown>[];
  ogType?: 'website' | 'article';
  ogSlug?: string;
}

const {
  title,
  description,
  noindex = false,
  jsonLd = [],
  ogType = 'website',
  ogSlug,
} = Astro.props;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Motion gate: the class exists only when motion will run, so no-JS and reduced-motion show final layout.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('js-motion');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {title} {description} {noindex} {jsonLd} {ogType} {ogSlug} />
    <link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-[var(--radius-control)] focus:bg-ink focus:px-4 focus:py-3 focus:text-white"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/motion/index.ts';
    </script>
  </body>
</html>
