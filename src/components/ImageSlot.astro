---
// Clearly labelled placeholder until real photography exists (never AI faces, never stock art).
interface Props {
  ratio?: '16/10' | '4/5' | '1/1';
  label: string;
  class?: string;
}
const { ratio = '16/10', label, class: className = '' } = Astro.props;
---

<div
  role="img"
  aria-label={`Photo placeholder: ${label}`}
  style={`aspect-ratio:${ratio}`}
  class:list={[
    'grid place-items-center rounded-[var(--radius-media)] border border-dashed border-blue-200 bg-blue-50 p-6 text-center text-sm text-slate',
    className,
  ]}
>
  <span>Photo slot: {label}</span>
</div>
