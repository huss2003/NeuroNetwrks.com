---
import Logo from './Logo.astro';
import Button from './Button.astro';
const nav = [
  { href: '/programs/', label: 'Programs' },
  { href: '/for-students/', label: 'Students' },
  { href: '/for-parents/', label: 'Parents' },
  { href: '/for-schools/', label: 'Schools' },
  { href: '/resources/', label: 'Resources' },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/95 backdrop-blur-sm">
  <div class="container-page flex min-h-16 items-center justify-between gap-4">
    <a href="/" aria-label="NeuroNetworks AI Ed, home" class="inline-flex min-h-11 items-center">
      <Logo />
    </a>
    <nav aria-label="Primary" class="hidden items-center gap-6 lg:flex">
      {nav.map((n) => (
        <a
          href={n.href}
          class="inline-flex min-h-11 items-center text-ink no-underline hover:underline"
        >
          {n.label}
        </a>
      ))}
    </nav>
    <div class="hidden items-center gap-3 lg:flex">
      <Button href="/contact/" variant="text">
        Talk to us
      </Button>
      <Button href="/apply/">Apply</Button>
    </div>
    <!-- Mobile menu: native details, works without JS -->
    <details class="relative lg:hidden">
      <summary class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-[var(--radius-control)] border border-line px-3 font-semibold">
        Menu
      </summary>
      <div class="absolute right-0 mt-2 grid w-64 gap-1 rounded-[var(--radius-control)] border border-line bg-bg p-3 shadow-raised">
        {nav.map((n) => (
          <a href={n.href} class="inline-flex min-h-11 items-center text-ink no-underline">
            {n.label}
          </a>
        ))}
        <Button href="/apply/" class="mt-2">
          Apply
        </Button>
        <Button href="/contact/" variant="secondary">
          Talk to us
        </Button>
      </div>
    </details>
  </div>
</header>
