---
import JsonLd from './JsonLd.astro';
interface Props {
  items: { name: string; href: string }[];
}
const { items } = Astro.props;
const site = Astro.site ?? new URL('https://neuronetwrks.com');
const data = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((it, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: it.name,
    item: new URL(it.href, site).toString(),
  })),
};
---

<nav aria-label="Breadcrumb" class="text-sm text-slate">
  <ol class="flex flex-wrap gap-x-2">
    {items.map((it, i) => (
      <li class="flex gap-2">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i < items.length - 1 ? (
          <a href={it.href}>{it.name}</a>
        ) : (
          <span aria-current="page">{it.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
<JsonLd data={data} />
