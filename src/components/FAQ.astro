---
import JsonLd from './JsonLd.astro';
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
const data = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.a },
  })),
};
---

<div class="border-b border-line">
  {items.map((i) => (
    <details class="group border-t border-line">
      <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-4 font-display text-lg font-bold">
        {i.q}
        <span aria-hidden="true" class="text-blue-700 transition-transform group-open:rotate-45">
          +
        </span>
      </summary>
      <p class="max-w-[62ch] pb-5 text-slate">{i.a}</p>
    </details>
  ))}
</div>
<JsonLd data={data} />
