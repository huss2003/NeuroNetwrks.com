---
interface Props {
  year: string;
  hours?: string;
  topics: string[];
}
const { year, hours, topics } = Astro.props;
---

<div class="grid gap-4 border-t border-line py-8 md:grid-cols-[12rem_1fr] md:gap-10">
  <div>
    <h3 class="font-display text-xl font-bold">{year}</h3>
    {hours && <p class="text-sm text-slate">{hours}</p>}
  </div>
  <ul class="grid gap-x-8 gap-y-2 sm:grid-cols-2">
    {topics.map((t) => (
      <li class="border-b border-line pb-2">{t}</li>
    ))}
  </ul>
</div>
