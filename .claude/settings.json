{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx astro *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git push origin *)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(.dev.vars)",
      "Read(**/*.pem)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx prettier --write --ignore-unknown \"$CLAUDE_FILE_PATH\""
          }
        ]
      }
    ],
    "Stop": [{ "hooks": [{ "type": "command", "command": "npm run check" }] }]
  }
}
