{
 "cleanUrls": true,
 "trailingSlash": false,
 "redirects": [
  {
   "source": "/faculty-and-team",
   "destination": "/about",
   "permanent": true
  },
  {
   "source": "/guides/become-penetration-tester-after-10th",
   "destination": "/guides/become-ethical-hacker-after-10th",
   "permanent": true
  },
  {
   "source": "/guides/become-cyber-security-analyst-after-10th",
   "destination": "/guides/cyber-security-course-after-10th",
   "permanent": true
  },
  {
   "source": "/guides/become-python-developer-after-10th",
   "destination": "/guides/become-software-engineer-after-10th",
   "permanent": true
  },
  {
   "source": "/guides/become-full-stack-developer-after-10th",
   "destination": "/guides/become-web-developer-after-10th",
   "permanent": true
  },
  {
   "source": "/guides/become-cloud-engineer-after-10th",
   "destination": "/guides/become-software-engineer-after-10th",
   "permanent": true
  },
  {
   "source": "/guides/become-prompt-engineer-after-10th",
   "destination": "/guides/become-ai-engineer-after-10th",
   "permanent": true
  },
  {
   "source": "/guides/become-product-designer-after-10th",
   "destination": "/guides/ui-ux-designer-after-10th",
   "permanent": true
  },
  {
   "source": "/guides/become-product-manager-after-10th",
   "destination": "/guides/ui-ux-designer-after-10th",
   "permanent": true
  }
 ],
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "X-Frame-Options",
     "value": "DENY"
    },
    {
     "key": "Permissions-Policy",
     "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
    },
    {
     "key": "Content-Security-Policy-Report-Only",
     "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'none'"
    }
   ]
  },
  {
   "source": "/assets/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=3600, must-revalidate"
    }
   ]
  },
  {
   "source": "/((?!assets/).*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=0, must-revalidate"
    }
   ]
  }
 ]
}